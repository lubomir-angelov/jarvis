FROM python:3.11-slim

ARG CONTEXT_CLI_REF=v0.1.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        cargo \
        curl \
        findutils \
        git \
        grep \
        make \
        procps \
        rustc \
        sed \
        tini \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --branch "${CONTEXT_CLI_REF}" --depth 1 https://github.com/contextenginehq/context-cli.git /tmp/context-cli \
    && cargo build --manifest-path /tmp/context-cli/Cargo.toml --release \
    && install -m 0755 /tmp/context-cli/target/release/context /usr/local/bin/context \
    && rm -rf /tmp/context-cli

RUN python -m pip install --upgrade pip \
    && python -m pip install aider-chat

WORKDIR /workspace/target
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]