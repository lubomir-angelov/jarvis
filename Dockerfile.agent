FROM python:3.11-slim

ARG CONTEXT_CLI_VERSION=0.1.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        cargo \
        curl \
        findutils \
        git \
        grep \
        make \
        procps \
        rustc \
        sed \
        tini \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"

RUN cargo install context-cli --version "${CONTEXT_CLI_VERSION}" \
    && install -m 0755 /root/.cargo/bin/context /usr/local/bin/context \
    && /usr/local/bin/context --help >/dev/null

RUN python -m pip install --upgrade pip \
    && python -m pip install aider-chat

WORKDIR /workspace/target
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]