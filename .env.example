# LLM config (local)
OPENAI_API_KEY=token-local-dev
LLM_PORT=8001
MODEL_ALIAS=qwen3.6-27b
MODEL_HF_REPO=unsloth/Qwen3.6-27B-GGUF
MODEL_HF_QUANT=UD-Q4_K_XL
LLM_CTX_SIZE=32768
LLM_TEMP=0.6
