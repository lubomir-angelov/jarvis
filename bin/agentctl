#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIR}"

if [[ $# -eq 0 ]]; then
  make help
  exit 0
fi

case "$1" in
  set-target)
    shift
    make set-target TARGET_REPO="$1"
    ;;
  task)
    shift
    make task TASK="$*"
    ;;
  shell)
    make shell
    ;;
  up)
    make up
    ;;
  down)
    make down
    ;;
  status)
    make status
    ;;
  health)
    make health
    ;;
  *)
    make "$@"
    ;;
esac
